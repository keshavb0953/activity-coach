{
  "goals": "Describe what you are trying to achieve, in your own words. Example: Grow my CA practice (project finance + virtual CFO), ship the marketplace web app, publish 2 YouTube videos a week, and avoid losing whole afternoons to email and random browsing.",

  "sample_interval_seconds": 5,
  "analysis_interval_minutes": 60,
  "idle_threshold_seconds": 180,
  "send_screenshots": false,
  "screenshots_per_analysis": 1,
  "data_dir": "~/.activity_coach",

  "provider": "claude",

  "providers": {
    "claude": {
      "api_key_env": "ANTHROPIC_API_KEY",
      "model": "claude-sonnet-4-5",
      "base_url": "https://api.anthropic.com/v1/messages",
      "anthropic_version": "2023-06-01"
    },
    "gemini": {
      "api_key_env": "GEMINI_API_KEY",
      "model": "gemini-2.0-flash"
    },
    "openai": {
      "api_key_env": "OPENAI_API_KEY",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1/chat/completions"
    }
  }
}
